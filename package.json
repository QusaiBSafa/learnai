{
  "name": "learnai",
  "version": "0.1.0",
  "private": true,
  "description": "Learn AI for free: an animated roadmap of courses with hand-picked resources and code you can run in the browser.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "node --no-warnings scripts/seed.mjs",
    "validate": "node --no-warnings scripts/seed.mjs --check",
    "dev": "npm run seed && next dev",
    "build": "npm run seed && next build",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "codemirror": "6.0.2",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
